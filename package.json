{
  "name": "rp-ledger",
  "private": true,
  "version": "1.4.10",
  "description": "印尼盾本地记账软件",
  "author": "RP Ledger",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:smoke": "node scripts/smoke-logic.mjs",
    "test:integration": "node scripts/integration-ledger.mjs",
    "test:all": "npm run test:smoke && npm run test:integration",
    "test:launch": "node scripts/launch-smoke.mjs",
    "test:ui": "node scripts/ui-e2e.mjs",
    "test:ui:20": "node scripts/ui-e2e-20.mjs",
    "dist": "npm run test:all && npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "dayjs": "^1.11.21",
    "exceljs": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.rpledger.app",
    "productName": "印尼盾记账",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "印尼盾记账",
      "language": "2052"
    }
  }
}
